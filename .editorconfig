root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Third-party files are kept byte for byte as published.
[{vendor,rulesets,schemas,tests/conformance/corpus}/**]
end_of_line = unset
insert_final_newline = unset
charset = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
