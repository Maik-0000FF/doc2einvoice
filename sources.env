#
# Where the files of other publishers in this repository come from: the rule
# files, the XML Schema files, the test documents, the reference stylesheets
# and the typeface, each pinned to a version and a checksum. Read by
# tools/regenerate-conformance.sh, tools/verify-sources.sh and the conformance
# tests.

# EN 16931 validation artefacts (CEN/TC 434), licensed under EUPL-1.2.
EN16931_VERSION=1.3.17
EN16931_PUBLISHED=2026-10-12
EN16931_ARCHIVE_URL=https://github.com/ConnectingEurope/eInvoicing-EN16931/archive/refs/tags/validation-1.3.17.tar.gz
EN16931_ARCHIVE_SHA256=44b3a8ffd4b0d0b88e9da0d5f6beae065bbf7b28ae398df8044506635b5e19f7

# XRechnung Schematron rules (KoSIT), licensed under Apache-2.0.
XRECHNUNG_VERSION=3.0.2
XRECHNUNG_RULES_VERSION=2.6.0
XRECHNUNG_RULES_PUBLISHED=2026-09-02
XRECHNUNG_RULES_URL=https://github.com/itplr-kosit/xrechnung-schematron/releases/download/v2.6.0/xrechnung-3.0.2-schematron-2.6.0.zip
XRECHNUNG_RULES_SHA256=ca5e07afd04e72cd283d581590ffff3a15f4aac9d2f40c993345d78e67ea22b4

# XRechnung test suite (KoSIT), licensed under Apache-2.0.
XRECHNUNG_TESTSUITE_VERSION=2026-08-31
XRECHNUNG_TESTSUITE_URL=https://github.com/itplr-kosit/xrechnung-testsuite/releases/download/v2026-08-31/xrechnung-3.0.2-testsuite-2026-08-31.zip
XRECHNUNG_TESTSUITE_SHA256=1e81ef7563e0fa04c0e0b0631318a7e0843a3c0beb57d83ef95ac0c4a095e3d7

# SchXslt compiles Schematron to the reference stylesheet (MIT). It is a tool
# of the reference run only and never part of the application.
SCHXSLT_REPOSITORY=https://codeberg.org/SchXslt/schxslt.git
SCHXSLT_COMMIT=11fd6973d0e7c5769ce55f817b2a9f300b8a741c

# XML Schema files of UBL 2.1 (OASIS) and CII D16B (UN/CEFACT), taken from the
# validator configuration of XRechnung (KoSIT), which bundles the files the
# official validator uses. Each carries the notice of its publisher.
XML_SCHEMAS_VERSION=2026-08-31
XML_SCHEMAS_URL=https://github.com/itplr-kosit/validator-configuration-xrechnung/releases/download/v2026-08-31/xrechnung-3.0.2-validator-configuration-2026-08-31.zip
XML_SCHEMAS_SHA256=2530cd107c414511c5d0462ec10f886910395abfca820db82e83d70bf01221a8

# The typeface Inter (The Inter Project Authors), licensed under OFL-1.1. The
# two variable font files of the interface are taken from the web directory of
# the release archive.
INTER_VERSION=4.1
INTER_PUBLISHED=2024-11-16
INTER_URL=https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip
INTER_SHA256=9883fdd4a49d4fb66bd8177ba6625ef9a64aa45899767dde3d36aa425756b11e

# Postal codes and places (GeoNames), licensed under CC-BY-4.0, reduced to
# country, postal code and place by tools/update-postcodes.sh. GeoNames renews
# the files daily and keeps no earlier ones, so the checksums record what the
# table was made from but cannot be checked again.
GEONAMES_POSTCODES_URL=https://download.geonames.org/export/zip
GEONAMES_POSTCODE_COUNTRIES="AT CH DE FR"
GEONAMES_POSTCODES_DOWNLOADED=2026-11-21
GEONAMES_AT_SHA256=aaebbf10ea49b1b39500d6099ae36e4ea8291d6b78d91d3abc45a58e31321e34
GEONAMES_CH_SHA256=9a89ff5e1e15d98f4179d4beb48a9bbe71ba4e5d3d666f95d4d10e976475ad38
GEONAMES_DE_SHA256=0b9309d9febff94487ab7c3429e0467e38cf7ffec96679d92ec73f82198758c9
GEONAMES_FR_SHA256=91b1f5353ab7379a64fa2d74a2450c5d43bb9da715f0738ac3ade356253240ff
